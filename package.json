{
  "name": "hebrew-immersion",
  "version": "0.3.0",
  "description": "Hebrew Immersion: curso offline com IA online opcional",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux dir --config.electronDist=node_modules/electron/dist --config.directories.output=dist/pronto",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "org.hebrewimmersion.App",
    "productName": "Hebrew Immersion",
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Education"
    },
    "files": [
      "src/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ]
  }
}
